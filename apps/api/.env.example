DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
REDIS_URL="redis://HOST:6379"
JWT_SECRET="generate-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
FS_HOST=127.0.0.1
FS_PORT=8021
FS_PASSWORD=ClueCon

FS_CONF_DIR="/path/to/freeswitch/conf"   # co-located: local conf dir to write config into

# Decoupled FreeSWITCH (FS on a separate box): push Sofia gateway config over SSH
# instead of writing locally. Directory/dialplan/callcenter are pulled via
# xml_curl; only gateways must be files on the FS box. Leave FS_SSH_TARGET blank
# to use the local-write path above. The SSH user needs write access (sudo) to
# FS_GATEWAY_DIR — use a dedicated restricted key in production.
FS_SSH_TARGET=""                          # e.g. "user@fs-host" or an ~/.ssh/config alias; blank = co-located
FS_GATEWAY_DIR="/etc/freeswitch/sip_profiles/external"
# FS_SSH_KEY="/path/to/id_ed25519"        # optional explicit key
# FS_SSH_PORT="22"                         # optional
# FS_SSH_SUDO="true"                       # write via `sudo tee` (default true)

FS_REQUIRED_MODULES="mod_callcenter,mod_avmd"

FS_WS_URL="ws://YOUR_FS_HOST:5066"   # wss://host:7443 in production
FS_STUN_URL="stun:stun.l.google.com:19302"

FS_RECORDINGS_DIR="/var/lib/freeswitch/recordings"

# VoipSwitch carrier — auto-provisions one registering SIP trunk (retail client)
# per tenant at signup. Leave unset to disable provisioning entirely (signup still
# works; trunks can be added manually under PBX → Trunks).
# Values below are the recipe validated end-to-end (a live PSTN call completed).
VOIPSWITCH_API_URL="http://37.9.63.182/VS.WebAPI.Admin"
VOIPSWITCH_ADMIN_LOGIN="your-admin-login"
VOIPSWITCH_ADMIN_PASSWORD="your-admin-password"
VOIPSWITCH_SIP_PROXY="37.9.63.182"   # SIP registrar host tenants' gateways register to
VOIPSWITCH_TARIFF_ID=40              # an NGN ST_* tariff with real outbound routes (e.g. ST_12=40)
VOIPSWITCH_RESELLER_ID=-1            # MUST be the master/-1 reseller; sub-resellers' tariffs 402
VOIPSWITCH_CLIENT_TYPE=32           # retail (the registering account type on this platform)
VOIPSWITCH_TECH_PREFIX="DP:0->3344 OR 234->3344"  # dialed-number routing rule; MUST be DP:-prefixed (-> the client's Dialing rules). CP:!<DID> (caller id) is prepended automatically
VOIPSWITCH_DID_COUNTRY_ID=15        # DID pool to allocate per-tenant caller-id from (Nativetalk=15)
VOIPSWITCH_ACCOUNT_STATE=1          # 1 = active
VOIPSWITCH_COUNTRY=""               # optional ISO country for new clients
VOIPSWITCH_STARTER_CREDIT=0         # free credit (carrier currency, e.g. NGN) granted at signup; 0 = none

# mod_xml_curl: FreeSWITCH fetches directory/dialplan XML from the API
FS_XML_SECRET="generate-a-long-random-string"
FS_SIP_BASE_DOMAIN="sip.yourdomain.com"   # per-tenant SIP domains: <slug>.<this>
FS_DEFAULT_TENANT_SLUG="tech4mation"       # fallback tenant for single-domain testing
